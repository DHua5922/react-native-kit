{
  "name": "@dhua5922/react-native-kit",
  "version": "0.0.0",
  "description": "React Native component library",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "rm -rf node_modules && yarn && yarn build && cd documentation && rm -rf node_modules && yarn && yarn start",
    "clean": "rm -rf dist",
    "build": "yarn clean && tsc -p tsconfig.build.json && babel dist --out-dir dist --copy-files",
    "prepack": "yarn build && yarn test --runInBand",
    "pack:check": "npm pack --dry-run",
    "test": "jest --coverage",
    "test:watch": "jest --watchAll --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DHua5922/react-native-kit"
  },
  "keywords": [
    "React",
    "Native"
  ],
  "author": "Dylan Hua",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DHua5922/react-native-kit/issues"
  },
  "homepage": "https://www.huadylan.com/react-native-kit",
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.24.7",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/react-native": "^3.0.5",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.5",
    "@types/react-native": "^0.73.0",
    "@types/react-test-renderer": "^18.3.0",
    "@types/styled-components-react-native": "^5.2.5",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.71.6",
    "react-test-renderer": "18.2.0",
    "react-native-web": "^0.19.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-native": "^0.71.6",
    "react-native-web": "^0.19.4"
  },
  "dependencies": {
    "@expo/vector-icons": "^13.0.0",
    "date-fns": "^2.30.0",
    "react-native-vector-icons": "^9.2.0",
    "rn-css": "^1.8.14",
    "styled-components": "^6.1.13"
  }
}
